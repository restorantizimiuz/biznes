# Backend API manzili (build-vaqtli — Vite shuni JS ichiga "quyib qo'yadi")
VITE_API_URL=http://localhost:8080/api/v1

# "Stol uchun buyurtma" tugmasi Telegram'ning o'z QR skaneridan foydalanadi
# (uydan buyurtma sahifasidan stol rejimiga o'tish uchun). Skanerlangan QR
# aynan shu botga tegishli ekanini tekshirish uchun bot username kerak —
# aks holda mijoz boshqa restoranning stol QR kodini tasodifan skanerlab
# qo'yishi mumkin edi. Backend'dagi TELEGRAM_BOT_USERNAME bilan bir xil
# qiymat bo'lishi kerak (qarang: backend/.env.example).
VITE_BOT_USERNAME=mazzi_sushibot
