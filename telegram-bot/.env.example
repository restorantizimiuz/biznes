BOT_TOKEN=

# Telegram WebApp manzili — bot STOL buyurtmasi uchun shu havolani yuboradi.
# Telegram WebApp faqat HTTPS domenda ishlaydi.
WEBAPP_URL=https://your-telegram-webapp-domain.example.com

# Uydan buyurtma sahifasining bazasi. Bot oddiy /start ga shu havolani
# yuboradi: <WEB_MENU_URL>/menyu/<BUSINESS_CODE>
# Kafe aynan shu havolani Instagram profiliga qo'yadi.
# Bo'sh qoldirilsa WEBAPP_URL ishlatiladi (ikkalasi bitta domenda bo'lsa qulay).
WEB_MENU_URL=https://menu.example.com

# backend'dagi businesses.business_code bilan bir xil bo'lishi kerak (masalan: demo-cafe)
BUSINESS_CODE=
