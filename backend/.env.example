PORT=8080

# --- Ma'lumotlar bazasi ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cafesystem?sslmode=disable

# --- Redis (IXTIYORIY) ---
# Bildirishnomalar Redis'siz ham to'liq ishlaydi — ular server ichidagi hub
# orqali yuboriladi (internal/notify). Redis faqat bir nechta server nusxasi
# ishlaganda kerak bo'ladi. Railway/Render kabi hosting'lar to'liq REDIS_URL
# beradi; u sozlangan bo'lsa REDIS_ADDR/REDIS_PASSWORD e'tiborga olinmaydi.
REDIS_URL=
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# --- Xavfsizlik ---
# Ikkala kalit ham productionda albatta o'zgartiriladi va BIR XIL BO'LMASLIGI
# shart — aks holda kafe tokeni super-admin API'sida ham ishlab ketardi
# (server bunday holatda ishga tushmaydi).
JWT_SECRET=o-zgartiring-bu-maxfiy-kalit
PLATFORM_JWT_SECRET=o-zgartiring-bu-platforma-kaliti

# development | production
# production'da standart kalitlar bilan server ishga tushmaydi.
ENVIRONMENT=development

# --- CORS ---
# Productionda frontend domenlari vergul bilan yoziladi, masalan:
# ALLOWED_ORIGINS=https://kassa.example.com,https://menu.example.com,https://platform.example.com
# Bo'sh qoldirilsa "*" ishlatiladi — faqat lokal ishlab chiqish uchun.
ALLOWED_ORIGINS=*

# --- Fayllar ---
# Mahsulot rasmlari saqlanadigan papka. Railway'da bu doimiy diskka (volume)
# ko'rsatilishi SHART, aks holda har deploydan keyin rasmlar yo'qoladi:
# UPLOAD_DIR=/data/uploads
UPLOAD_DIR=./uploads

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Stol QR kodi uchun zaxira manzil (TELEGRAM_BOT_USERNAME sozlanmagan bo'lsa ishlatiladi)
QR_BASE_URL=https://menu.example.com

# --- Online buyurtma ---
# Kafe Instagram profiliga qo'yadigan ochiq menyu havolasi shu asosda
# yig'iladi: <baza>/menyu/<business_code>. U Sozlamalar sahifasida havola va
# QR kod ko'rinishida chiqadi. Productionda bu YERGA HAQIQIY DOMEN yozilishi
# shart — aks holda kafe localhost havolasini ulashib qo'yadi.
# Manzil frontend-telegram deploy qilingan domen bo'lishi kerak.
WEB_MENU_BASE_URL=https://menu.example.com

# Manzilni koordinatadan aniqlash (OpenStreetMap). Kalit talab qilmaydi.
# O'z Nominatim serveringizni ko'tarsangiz shu manzilni almashtirasiz.
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Namunaviy ma'lumot ---
# true bo'lsa 002_seed_demo.sql qo'llanadi ("Demo Cafe", admin/demo1234).
# Ishlab chiqarish bazasida HECH QACHON yoqilmasin — parol hammaga ma'lum.
SEED_DEMO=false
