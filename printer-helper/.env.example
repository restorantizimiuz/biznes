# Bu yordamchi dastur kassir kompyuterida (backend serveridan alohida) ishga tushiriladi.

# Ishga tushirish porti (kassa paneli shu manzilga so'rov yuboradi: http://127.0.0.1:9123/print)
HELPER_PORT=9123

# PRINTER_MODE: network | file | (bo'sh — printer ulanmagan, har doim Telegram'ga o'tadi)
PRINTER_MODE=

# PRINTER_MODE=network bo'lsa: tarmoqqa ulangan termal printerning IP:port manzili
# (aksariyat Ethernet/Wi-Fi chek printerlari RAW/JetDirect uchun 9100-portni tinglaydi)
PRINTER_ADDRESS=192.168.1.50:9100

# PRINTER_MODE=file bo'lsa: Linux'dagi USB printer qurilma fayli
PRINTER_DEVICE=/dev/usb/lp0
